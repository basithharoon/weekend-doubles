rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read and record games. Writes are checked for the right shape.
    match /players/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'guest', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.guest is bool;
      allow delete: if true;
    }
    match /matches/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'a', 'b', 'sa', 'sb', 'at', 'unfinished'])
        && (!('unfinished' in request.resource.data) || request.resource.data.unfinished is bool)
        && request.resource.data.a is list && request.resource.data.a.size() == 2
        && request.resource.data.b is list && request.resource.data.b.size() == 2
        && request.resource.data.sa is int && request.resource.data.sb is int
        && request.resource.data.sa >= 0 && request.resource.data.sb >= 0
        && request.resource.data.sa <= 99 && request.resource.data.sb <= 99
        && request.resource.data.sa != request.resource.data.sb;
      allow delete: if true;
      // Only the date and the "unfinished" flag can be changed after a game is saved
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unfinished', 'date'])
        && (!('unfinished' in request.resource.data) || request.resource.data.unfinished is bool)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
  }
}
